\citation{bellec2024beat}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The primary contrast, problem by problem: E $-$ A on the fraction of the seed-to-record gap closed (pooled over two replicates). Small grey dots are the two replicates (lines join them); the large dot is their mean. The pooled mean is $+0.196$; the median, $+0.045$; leave-one-problem-out means stay between $+0.153$ and $+0.224$. Within-problem replicate spread is large on several problems (circle packing: $+0.01$ and $+0.56$), which the problem-level test does not see.\relax }}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:forest}{{1}{5}{The primary contrast, problem by problem: E $-$ A on the fraction of the seed-to-record gap closed (pooled over two replicates). Small grey dots are the two replicates (lines join them); the large dot is their mean. The pooled mean is $+0.196$; the median, $+0.045$; leave-one-problem-out means stay between $+0.153$ and $+0.224$. Within-problem replicate spread is large on several problems (circle packing: $+0.01$ and $+0.56$), which the problem-level test does not see.\relax }{figure.caption.8}{}}
